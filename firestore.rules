rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Whitelist: un documento per email in minuscolo -> whitelist/{email}
    // Si gestisce solo dalla Console Firebase (nessuno può scriverla dal client).
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/whitelist/$(request.auth.token.email.lower()));
    }

    match /whitelist/{email} {
      allow read, write: if false;
    }

    match /sessions/{sessionId} {
      allow get: if allowed();     // solo lettura puntuale, niente list
      allow list: if false;
      // Scrittura: l'app Android (stesso utente Google o service account)
      allow create, update, delete: if allowed();
    }
  }
}
